{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "outDir": "dist",
    // `vitest/globals` because vitest.config.ts sets `globals: true`, so the
    // migrated suite uses bare describe/it/expect without importing them.
    "types": ["node", "vitest/globals"],
    "paths": {
      "@": ["./src/index.ts"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules", "dist", "coverage"]
}
