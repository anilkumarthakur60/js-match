{
  "name": "@anilkumarthakur/match",
  "version": "0.1.3",
  "description": "PHP-style match expressions for JavaScript/TypeScript",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Anil Kumar Thakur",
    "url": "https://github.com/anilkumarthakur60"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anilkumarthakur60/js-match.git",
    "directory": "packages/match"
  },
  "homepage": "https://anilkumarthakur60.github.io/js-match",
  "bugs": {
    "url": "https://github.com/anilkumarthakur60/js-match/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.global.js",
  "jsdelivr": "./dist/index.global.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "rm -rf dist coverage",
    "build": "tsup && node scripts/check-dist.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@types/node": "^25.0.9",
    "@vitest/coverage-v8": "^4.1.10",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "match",
    "match-expression",
    "pattern-matching",
    "php-match",
    "typescript",
    "javascript",
    "switch-alternative",
    "conditional"
  ]
}
