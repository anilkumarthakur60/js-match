{
  "name": "js-match",
  "private": true,
  "type": "module",
  "description": "Monorepo for @anilkumarthakur/match — PHP-style match expressions for JavaScript/TypeScript.",
  "license": "MIT",
  "author": {
    "name": "Anil Kumar Thakur",
    "url": "https://github.com/anilkumarthakur60"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anilkumarthakur60/js-match.git"
  },
  "homepage": "https://anilkumarthakur60.github.io/js-match",
  "bugs": {
    "url": "https://github.com/anilkumarthakur60/js-match/issues"
  },
  "scripts": {
    "clean": "pnpm -r --parallel run clean",
    "build": "pnpm --filter @anilkumarthakur/match run build",
    "build:examples": "pnpm --filter \"./examples/*\" run build",
    "test": "pnpm --filter @anilkumarthakur/match run test",
    "test:watch": "pnpm --filter @anilkumarthakur/match run test:watch",
    "test:coverage": "pnpm --filter @anilkumarthakur/match run test:coverage",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test",
    "docs:dev": "pnpm --filter docs run dev",
    "docs:build": "pnpm --filter docs run build",
    "docs:preview": "pnpm --filter docs run preview",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^5.10.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.15.0"
}
